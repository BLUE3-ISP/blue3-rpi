{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "ESTE ARQUIVO NAO ESCOLHE O MODELO, DE PROPOSITO (24/09/2026 — ADR-027 do repodocs). Sem `model`, sem `fallbackModel` e nada no `env` que o direcione: sem `ANTHROPIC_MODEL`, sem `ANTHROPIC_DEFAULT_*_MODEL`, sem `CLAUDE_CODE_SUBAGENT_MODEL`. O modelo e escolha do usuario, feita com /model, e o subagente herda. O effortLevel maximo aceito em ARQUIVO e 'xhigh'; 'max' so por sessao (/effort max).",
  "effortLevel": "xhigh",
  "permissions": {
    "_comment": "Permissoes do projeto - shell/scripts",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(node -c:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ],
    "ask": [
      "Bash(sudo:*)"
    ]
  }
}
